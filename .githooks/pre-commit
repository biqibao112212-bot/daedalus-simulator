#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PERFORMANCE_PATHS='^(Cargo\.toml|Cargo\.lock|src/|assets/|config\.performance\.toml|release/|sdk/)'

if command -v cargo >/dev/null 2>&1; then
  CARGO=cargo
elif command -v cargo.exe >/dev/null 2>&1; then
  CARGO=cargo.exe
elif [[ -x "${USERPROFILE:-}/.cargo/bin/cargo.exe" ]]; then
  CARGO="${USERPROFILE}/.cargo/bin/cargo.exe"
else
  echo 'pre-commit: cargo is required for formatting and Release performance validation.' >&2
  exit 1
fi

echo "Running cargo fmt --check..."
if ! "$CARGO" fmt -- --check; then
  echo ""
  echo "Rust code is not formatted. Please run 'cargo fmt'." >&2
  exit 1
fi

STAGED="$(git diff --cached --name-only)"
if ! grep -Eq "$PERFORMANCE_PATHS" <<<"$STAGED"; then
  exit 0
fi

# A benchmark that includes unstaged performance-relevant source cannot prove
# the staged commit, so force the author to stage or separate those changes.
UNSTAGED="$(git diff --name-only)"
if grep -Eq "$PERFORMANCE_PATHS" <<<"$UNSTAGED"; then
  echo 'pre-commit: performance-relevant unstaged changes detected; stage or separate them before measuring.' >&2
  exit 1
fi

if [[ "$(uname -s)" != "Linux" ]]; then
  echo 'pre-commit: performance-relevant changes must be committed from the supported Linux release environment.' >&2
  exit 1
fi

# Contest releases are Linux-only. Keep the performance gate native so it
# measures the same binary, renderer, and runtime contract that we publish.
# The script records raw evidence under the workspace runtime directory; that
# evidence is intentionally not part of the commit because the tree is still
# staged while this hook runs.
"$ROOT/scripts/measure-performance.sh" \
  --build \
  --mode performance \
  --duration-seconds 20 \
  --minimum-main-update-hz 171.190 \
  --minimum-capture-submit-hz 163.228
