{
  "product": "daedalus-simulator",
  "version": "1.4.0-learning",
  "sdk_version": "1.4.0-learning",
  "shm_version": 7,
  "sdk_abi_revision": 2,
  "image": {
    "default_transport": "tcp",
    "format": "rgba32",
    "channels": 4,
    "width": 1440,
    "height": 1080
  },
  "physics_hz": 250,
  "ballistics": {
    "projectile_speed_mps": 25.0,
    "gravity_world_mps2": [0.0, -9.81, 0.0],
    "aerodynamic_drag_enabled": false,
    "projectile_diameter_m": 0.017,
    "projectile_mass_kg": 0.0032,
    "minimum_fire_interval_s": 0.05
  },
  "gimbal": {
    "command_mode": "absolute_chassis_local",
    "yaw_zero_deg": 0.0,
    "pitch_level_deg": 90.0,
    "pitch_min_deg": 45.0,
    "pitch_max_deg": 135.0,
    "maximum_rate_rad_s": 3.0,
    "command_stale_timeout_ms": 250
  },
  "default_image_transport": "tcp",
  "tcp_image_port": 5602,
  "udp_command_port": 5601,
  "scene_control_protocol": 2,
  "scene_control_port": 5603,
  "distribution_profile": "learning",
  "distribution_locked": true,
  "competition_eligible": false,
  "future_truth_included": false,
  "learning_profile": {
    "linux_only": true,
    "supported_scenes": ["shooting_range", "energy"],
    "unsupported_scenes": ["armor", "outpost"],
    "online_ground_truth": {
      "enabled_by_default": true,
      "disable_environment_variable": "DAEDALUS_LEARNING_TRUTH=0",
      "sdk_method": "TalosMetadataReader::readGroundTruthForFrame",
      "identity": "producer_epoch + frame_seq + timestamp_ns",
      "history_slots": 16,
      "future_truth_included": false,
      "fields": ["target_pose", "target_velocity", "target_angular_velocity", "armor_slots", "armor_id", "visibility", "armor_geometry", "rune_state"]
    },
    "big_rune_score": {
      "sdk_method": "ContestClient::getBigRuneScore",
      "cli_command": "daedalus-contest score red|blue",
      "effective_detection_diameter_mm": 300,
      "rings": "1-10, centre to outer edge"
    }
  },
  "fixed_calibration": "camera-calibration.json",
  "fixed_calibration_revision": 2,
  "runtime_capabilities": "daedalus-runtime-capabilities-v1.json",
  "offline_exports": {
    "exact_corner_labels": {
      "schema_version": "daedalus.offline-exact-corners/1",
      "schema_file": "schemas/offline-exact-corners-v1.schema.json",
      "environment_variable": "DAEDALUS_CORNER_LABELS_JSONL",
      "default_enabled": false,
      "requires_tcp_client": true,
      "commit_point": "after_complete_tcp_frame_write",
      "online_target_truth_enabled": true,
      "future_truth_included": false
    },
    "full_frame_capture": {
      "schema_version": "daedalus.offline-frame-capture/1",
      "schema_file": "schemas/offline-frame-capture-v1.schema.json",
      "collector_option": "--save-rgba-frames",
      "default_enabled": false,
      "requires_until_eof": true,
      "image_format": "rgba32-raw",
      "online_target_truth_enabled": true,
      "future_truth_included": false
    }
  },
  "inference_payload_included": false
}
