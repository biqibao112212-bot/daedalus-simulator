  "default_image_transport": "tcp",
  "tcp_image_port": 5602,
  "udp_command_port": 5601,
  "scene_control_protocol": 2,
  "scene_control_port": 5603,
  "distribution_profile": "internal-lab",
  "distribution_locked": true,
  "fixed_calibration": "camera-calibration.json",
  "fixed_calibration_revision": 2,
  "runtime_capabilities": "daedalus-runtime-capabilities-v1.json",
  "inference_payload_included": false
