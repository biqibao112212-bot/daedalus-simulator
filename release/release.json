{
  "product": "daedalus-simulator",
  "version": "1.2.1",
  "sdk_version": "1.2.0",
  "shm_version": 7,
  "sdk_abi_revision": 2,
  "image": {
    "default_transport": "tcp",
    "format": "rgba32",
    "channels": 4,
    "width": 1440,
    "height": 1080
  },
  "physics_hz": 250,
